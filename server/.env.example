# HELIX Backend Environment Variables (Server Only / Never Expose to Browser)
PORT=5000

# Database & Authentication (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# ---------------------------------------------------------------------------
# AI Engine Provider Configuration
# Options: gemini | groq | ollama
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama
AI_TIMEOUT_MS=45000

# 1. Local Open-Weight Inference (Ollama on Windows/macOS/Linux)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# 2. Cloud Open-Weight & Frontier Inference (Groq)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# 3. Frontier Cloud Multimodal (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Video Discovery (YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_api_key

# Firebase Admin Push Notifications (Optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
